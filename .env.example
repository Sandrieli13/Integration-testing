# Copy to .env and fill in ( .env is gitignored ).
# BLS key: https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# Prefer this OEWS year from the API when present; use latest only: BLS_OEWS_PREFER_YEAR=latest
BLS_OEWS_PREFER_YEAR=2025
# Ignore data/tech_career_stats_override.json: TECH_CAREER_STATS_OVERRIDE_DISABLE=1
